<!DOCTYPE html>
<html
  lang="en"
  data-theme={
    html_theme(if @conn.private[:default_appearance], do: nil, else: assigns[:current_scope])
  }
  data-mode={
    html_mode(if @conn.private[:default_appearance], do: nil, else: assigns[:current_scope])
  }
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="textbin" suffix=" · textbin">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only z-50 rounded-lg bg-base-100 px-4 py-2 font-semibold text-base-content shadow-lg outline outline-2 outline-primary focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Skip to main content
    </a>
    {@inner_content}
  </body>
</html>

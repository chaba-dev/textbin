<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  navigation_workspaces={@navigation_workspaces}
  active_navigation={{:workspace, :pastes}}
>
  <div class="space-y-8">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="space-y-2">
        <p class="text-sm font-medium uppercase tracking-wide text-base-content/60">
          Paste
        </p>
        <h1 class="break-all font-mono text-lg font-semibold text-base-content">
          {@paste.id}
        </h1>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <span id="paste-content-type" class="badge badge-sm badge-outline">
            {@paste.content_type}
          </span>
          <span class="badge badge-sm badge-outline">{@paste.syntax_highlight}</span>
          <span id="paste-audience" class="badge badge-sm badge-outline">
            {String.capitalize(@paste.audience)}
          </span>
          <time
            class="block text-sm text-base-content/60"
            datetime={DateTime.to_iso8601(@paste.inserted_at)}
          >
            Created {Calendar.strftime(@paste.inserted_at, "%Y-%m-%d %H:%M:%S UTC")}
          </time>
          <%= if @paste.expires_at do %>
            <time
              id="paste-expires-at"
              class="block text-sm text-base-content/60"
              datetime={DateTime.to_iso8601(@paste.expires_at)}
            >
              Expires {Calendar.strftime(@paste.expires_at, "%Y-%m-%d %H:%M:%S UTC")}
            </time>
          <% else %>
            <span id="paste-expires-at" class="block text-sm text-base-content/60">
              Never expires
            </span>
          <% end %>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button
          :if={@text_content?}
          id="copy-paste-content"
          type="button"
          phx-hook="CopyToClipboard"
          phx-update="ignore"
          data-copy-content={@paste.data}
          class="btn btn-sm btn-primary"
          title="Copy paste content"
        >
          <.icon name="hero-clipboard" class="size-4" />
          <span data-copy-label>Copy</span>
        </button>
        <.link
          id="raw-paste-link"
          href={~p"/pastes/#{@paste.id}/raw"}
          target="_blank"
          class="btn btn-sm btn-ghost"
          title="View raw paste"
        >
          <.icon name="hero-code-bracket" class="size-4" /> Raw
        </.link>
        <.link
          :if={@owner?}
          navigate={paste_index_path(@current_scope)}
          class="btn btn-sm btn-ghost"
        >
          Back to pastes
        </.link>
        <button
          :if={@owner?}
          id={"delete-paste-#{@paste.id}"}
          type="button"
          phx-click="delete"
          phx-value-id={@paste.id}
          data-confirm="Delete this paste?"
          class="btn btn-sm btn-error"
        >
          <.icon name="hero-trash" class="size-4" /> Delete
        </button>
      </div>
    </div>

    <div
      :if={@text_content?}
      id="paste-data"
      class="overflow-x-auto rounded-lg border border-base-300 bg-base-200 text-sm leading-6"
    >
      {@highlighted_paste_data}
    </div>
    <div
      :if={!@text_content?}
      id="paste-binary-data"
      class="rounded-lg border border-base-300 bg-base-200 p-8 text-center"
    >
      <.icon name="hero-document-arrow-down" class="mx-auto size-8 text-base-content/50" />
      <p class="mt-3 font-medium">Binary paste</p>
      <p class="mt-1 text-sm text-base-content/60">
        Preview is disabled. Use the raw link to download the original bytes.
      </p>
    </div>
  </div>
</Layouts.app>

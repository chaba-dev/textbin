<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  navigation_workspaces={@navigation_workspaces}
  active_navigation={{:workspace, :pastes}}
  default_appearance={@live_action == :show}
>
  <div class="space-y-6">
    <.link
      :if={workspace_member?(@current_scope)}
      id="back-to-pastes"
      navigate={paste_index_path(@current_scope)}
      class="inline-flex items-center gap-1 text-sm text-base-content/60 transition hover:text-base-content"
    >
      <.icon name="hero-arrow-left" class="size-4" /> Back to pastes
    </.link>

    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0 space-y-2">
        <h1
          id="paste-title"
          class="break-words text-2xl font-semibold tracking-tight text-base-content lg:text-3xl"
        >
          {Paste.display_title(@paste)}
        </h1>
        <p id="paste-id" class="break-all font-mono text-xs text-base-content/50">{@paste.id}</p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-base-content/70">
          <span id="paste-author">{author_label(@paste, @current_scope)}</span>
          <time datetime={DateTime.to_iso8601(@paste.inserted_at)}>
            Created {Calendar.strftime(@paste.inserted_at, "%Y-%m-%d %H:%M:%S UTC")}
          </time>
          <a
            :if={@paste.reference_url}
            id="paste-reference"
            href={@paste.reference_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex max-w-full items-center gap-1 break-all text-primary hover:underline"
          >
            <.icon name="hero-link" class="size-4 shrink-0" />
            {@paste.reference_url}
          </a>
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <button
          id="copy-paste-link"
          type="button"
          phx-hook="CopyToClipboard"
          phx-update="ignore"
          data-copy-content={@share_url}
          class="btn btn-sm btn-primary"
          title="Copy a link to this paste"
        >
          <.icon name="hero-link" class="size-4" />
          <span data-copy-label>Copy link</span>
        </button>
        <button
          :if={@text_content?}
          id="copy-paste-content"
          type="button"
          phx-hook="CopyToClipboard"
          phx-update="ignore"
          data-copy-content={@paste.data}
          class="btn btn-sm btn-ghost"
          title="Copy paste content"
        >
          <.icon name="hero-clipboard" class="size-4" />
          <span data-copy-label>Copy content</span>
        </button>
        <.link
          id="raw-paste-link"
          href={~p"/pastes/#{@paste.id}/raw"}
          target="_blank"
          class="btn btn-sm btn-ghost"
          title="View raw paste"
        >
          <.icon name="hero-code-bracket" class="size-4" /> Raw
        </.link>
        <.link
          id="download-paste-link"
          href={~p"/pastes/#{@paste.id}/raw?download=1"}
          class="btn btn-sm btn-ghost"
          title="Download this paste"
        >
          <.icon name="hero-arrow-down-tray" class="size-4" /> Download
        </.link>
        <.link
          :if={workspace_member?(@current_scope) && @text_content?}
          id="duplicate-paste-link"
          navigate={"#{new_paste_path(@current_scope)}?from=#{@paste.id}"}
          class="btn btn-sm btn-ghost"
          title="Start a new paste from this one"
        >
          <.icon name="hero-document-duplicate" class="size-4" /> Duplicate
        </.link>
        <button
          :if={@owner?}
          id={"delete-paste-#{@paste.id}"}
          type="button"
          phx-click="delete"
          phx-value-id={@paste.id}
          data-confirm="Delete this paste?"
          class="btn btn-sm btn-ghost text-error hover:bg-error/10"
        >
          <.icon name="hero-trash" class="size-4" /> Delete
        </button>
      </div>
    </div>

    <div
      id="paste-audience-banner"
      class="flex flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border border-base-300 bg-base-100 px-4 py-3 text-sm text-base-content/80"
    >
      <.icon
        name={
          case @paste.audience do
            "public" -> "hero-globe-alt"
            "unlisted" -> "hero-link"
            _audience -> "hero-user-group"
          end
        }
        class="size-4 shrink-0 text-base-content/50"
      />
      <span id="paste-audience-sentence">
        {audience_sentence(@paste, @current_scope)} {expiry_sentence(@paste.expires_at)}
      </span>
      <span class="ml-auto flex flex-wrap items-center gap-2">
        <span id="paste-audience" class="badge badge-sm badge-outline">
          {String.capitalize(@paste.audience)}
        </span>
        <%= if @paste.expires_at do %>
          <time
            id="paste-expires-at"
            class="badge badge-sm badge-outline"
            datetime={DateTime.to_iso8601(@paste.expires_at)}
          >
            Expires {Calendar.strftime(@paste.expires_at, "%Y-%m-%d %H:%M:%S UTC")}
          </time>
        <% else %>
          <span id="paste-expires-at" class="badge badge-sm badge-outline">
            Never expires
          </span>
        <% end %>
        <span id="paste-content-type" class="badge badge-sm badge-outline">
          {@paste.content_type}
        </span>
        <span class="badge badge-sm badge-outline">{@paste.syntax_highlight}</span>
      </span>
    </div>

    <div
      :if={@text_content?}
      id="paste-data"
      class="overflow-x-auto rounded-lg border border-base-300 bg-base-200 text-sm leading-6"
    >
      {@highlighted_paste_data}
    </div>
    <div
      :if={!@text_content?}
      id="paste-binary-data"
      class="rounded-lg border border-base-300 bg-base-200 p-8 text-center"
    >
      <.icon name="hero-document-arrow-down" class="mx-auto size-8 text-base-content/50" />
      <p class="mt-3 font-medium">Binary paste</p>
      <p class="mt-1 text-sm text-base-content/60">
        Preview is disabled. Use Download to get the original bytes.
      </p>
    </div>
  </div>
</Layouts.app>

<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  navigation_workspaces={@navigation_workspaces}
  active_navigation={{:workspace, :pastes}}
>
  <div class="space-y-6">
    <header class="space-y-4">
      <div class="flex items-end justify-between gap-4">
        <div class="min-w-0">
          <p class="truncate text-sm font-medium text-base-content/55">
            {@current_scope.organization.name}
          </p>
          <h1
            id="workspace-heading"
            class="mt-1 truncate text-2xl font-semibold tracking-tight text-base-content lg:text-3xl"
          >
            {@current_scope.workspace.name}
          </h1>
        </div>
        <.link
          id="new-paste-link"
          navigate={new_paste_path(@current_scope)}
          class="btn btn-primary btn-sm"
        >
          <.icon name="hero-plus" class="size-4" /> New paste
        </.link>
      </div>
      <Layouts.workspace_tabs scope={@current_scope} active={:pastes} />
      <h2 id="pastes-heading" class="sr-only">Pastes</h2>
    </header>

    <div id="pastes-list" phx-update="stream" class="space-y-3">
      <div
        id="pastes-empty"
        class="hidden min-h-56 flex-col rounded-lg border border-dashed border-base-300 p-10 text-center only:flex only:items-center only:justify-center"
      >
        <p class="text-base font-medium text-base-content/70">No pastes yet.</p>
        <p class="mt-1 text-sm text-base-content/50">
          Create one and it will show up here for the whole workspace.
        </p>
      </div>

      <article
        :for={{id, paste} <- @streams.pastes}
        id={id}
        class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm transition hover:border-base-content/20 hover:shadow-md"
      >
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <.link
              id={"paste-title-#{paste.id}"}
              navigate={paste_path(@current_scope, paste)}
              class="block truncate text-sm font-medium text-base-content hover:underline"
            >
              {Paste.display_title(paste)}
            </.link>
            <p class="mt-0.5 text-xs text-base-content/50">
              <span id={"paste-author-#{paste.id}"}>
                {author_label(paste, @current_scope)}
              </span>
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="badge badge-sm badge-outline">{paste.syntax_highlight}</span>
            <span id={"paste-audience-#{paste.id}"} class="badge badge-sm badge-outline">
              {Sharing.audience_label(paste.audience)}
            </span>
            <time
              class="text-xs text-base-content/50"
              datetime={DateTime.to_iso8601(paste.inserted_at)}
            >
              Created {Calendar.strftime(paste.inserted_at, "%Y-%m-%d %H:%M:%S UTC")}
            </time>
            <%= if paste.expires_at do %>
              <time
                id={"paste-expires-at-#{paste.id}"}
                class="text-xs text-base-content/50"
                datetime={DateTime.to_iso8601(paste.expires_at)}
              >
                Expires {Calendar.strftime(paste.expires_at, "%Y-%m-%d %H:%M:%S UTC")}
              </time>
            <% else %>
              <span id={"paste-expires-at-#{paste.id}"} class="text-xs text-base-content/50">
                Never expires
              </span>
            <% end %>
            <button
              :if={workspace_paste_manageable?(@current_scope, paste)}
              id={"delete-paste-#{paste.id}"}
              type="button"
              phx-click="delete"
              phx-value-id={paste.id}
              data-confirm="Delete this paste?"
              class="btn btn-ghost btn-xs text-error hover:bg-error/10"
              aria-label="Delete paste"
            >
              <.icon name="hero-trash" class="size-4" />
            </button>
          </div>
        </div>
      </article>
    </div>
  </div>
</Layouts.app>

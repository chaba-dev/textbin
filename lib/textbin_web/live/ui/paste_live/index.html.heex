<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  navigation_workspaces={@navigation_workspaces}
  active_navigation={{:workspace, :pastes}}
>
  <div class="space-y-8">
    <div>
      <p class="text-sm font-medium text-base-content/55">{@current_scope.workspace.name}</p>
      <h1 class="mt-1 text-3xl font-semibold tracking-tight text-base-content">
        Pastes
      </h1>
      <p class="mt-2 text-sm leading-6 text-base-content/70">
        Recently created snippets.
      </p>
    </div>

    <section
      id="new-paste"
      class="rounded-lg border border-base-300 bg-base-100 p-5 shadow-sm"
    >
      <.form
        for={@paste_form}
        id="paste-form"
        phx-change="validate"
        phx-submit="save"
        class="space-y-4"
      >
        <.input
          field={@paste_form[:data]}
          type="textarea"
          label="Paste content"
          rows="10"
          placeholder="Paste text here..."
          required
        />

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-end">
          <.input
            field={@paste_form[:syntax_highlight]}
            type="text"
            label="Syntax"
            placeholder="plain"
          />
          <.input
            field={@paste_form[:audience]}
            type="select"
            label="Audience"
            options={paste_audience_options(@current_scope)}
            disabled={guest_user?(@current_scope.user)}
          />
          <.input
            field={@paste_form[:expires_in]}
            type="select"
            label="Expiration"
            options={paste_ttl_options()}
          />
          <.button variant="primary" phx-disable-with="Creating...">
            Create Paste
          </.button>
        </div>
      </.form>
    </section>

    <div id="pastes-list" phx-update="stream" class="space-y-3">
      <div
        id="pastes-empty"
        class="hidden min-h-56 rounded-lg border border-dashed border-base-300 p-10 text-center text-base text-base-content/60 only:flex only:items-center only:justify-center"
      >
        No pastes yet.
      </div>

      <article
        :for={{id, paste} <- @streams.pastes}
        id={id}
        class="rounded-lg border border-base-300 bg-base-100 p-4 shadow-sm transition hover:border-base-content/20 hover:shadow-md"
      >
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <.link
            navigate={"#{paste_index_path(@current_scope)}/#{paste.id}"}
            class="break-all font-mono text-sm font-medium text-base-content hover:underline"
          >
            {paste.id}
          </.link>
          <div class="flex flex-wrap items-center gap-3">
            <span class="badge badge-sm badge-outline">{paste.syntax_highlight}</span>
            <span id={"paste-audience-#{paste.id}"} class="badge badge-sm badge-outline">
              {String.capitalize(paste.audience)}
            </span>
            <time
              class="text-xs text-base-content/50"
              datetime={DateTime.to_iso8601(paste.inserted_at)}
            >
              Created {Calendar.strftime(paste.inserted_at, "%Y-%m-%d %H:%M:%S UTC")}
            </time>
            <%= if paste.expires_at do %>
              <time
                id={"paste-expires-at-#{paste.id}"}
                class="text-xs text-base-content/50"
                datetime={DateTime.to_iso8601(paste.expires_at)}
              >
                Expires {Calendar.strftime(paste.expires_at, "%Y-%m-%d %H:%M:%S UTC")}
              </time>
            <% else %>
              <span id={"paste-expires-at-#{paste.id}"} class="text-xs text-base-content/50">
                Never expires
              </span>
            <% end %>
            <button
              :if={workspace_paste_manageable?(@current_scope, paste)}
              id={"delete-paste-#{paste.id}"}
              type="button"
              phx-click="delete"
              phx-value-id={paste.id}
              data-confirm="Delete this paste?"
              class="btn btn-ghost btn-xs text-error hover:bg-error/10"
              aria-label="Delete paste"
            >
              <.icon name="hero-trash" class="size-4" />
            </button>
          </div>
        </div>
      </article>
    </div>
  </div>
</Layouts.app>

#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
postgres_data_dir="$repo_root/tmp/postgres"
legacy_postgres_data_dir="$repo_root/.nix/postgres"

if [ -x "$HOME/.nix-profile/bin/nix" ]; then
  nix_bin="$HOME/.nix-profile/bin/nix"
elif command -v nix >/dev/null 2>&1; then
  nix_bin="$(command -v nix)"
else
  exit 0
fi

# A resumed Orb has to find the cluster it left behind; .agents/setup creates it
# on the first run. A cluster still living under .nix/postgres counts as present
# because the script adopts it into tmp/postgres before starting.
if [ ! -s "$postgres_data_dir/PG_VERSION" ] &&
  [ ! -s "$legacy_postgres_data_dir/PG_VERSION" ]; then
  exit 0
fi

"$nix_bin" --extra-experimental-features "nix-command flakes" develop "$repo_root" --command \
  ./scripts/local-postgres.sh start

#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
	echo "usage: $0 EMAIL" >&2
	exit 64
fi

encoded_email=$(printf '%s' "$1" | base64 | tr -d '\n')

exec "$(dirname "$0")/textbin" rpc \
	"email = Base.decode64!(\"$encoded_email\"); case Textbin.Release.grant_platform_admin(email) do {:ok, _result} = success -> success; {:error, reason} -> raise \"grant-platform-admin failed: #{inspect(reason)}\" end"
